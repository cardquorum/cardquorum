{
  "extends": ["../../tsconfig.base.json", "../../tsconfig.browser.json"],
  "compilerOptions": {
    "outDir": "./out-tsc/app"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "src/test-setup.ts"],
  "references": [
    {
      "path": "../../libs/shared/tsconfig.lib.json"
    },
    {
      "path": "../../libs/engine/tsconfig.lib.json"
    },
    {
      "path": "../../libs/games/sheepshead/tsconfig.lib.json"
    }
  ]
}
